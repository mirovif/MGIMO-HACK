# Locally, leave DATABASE_URL empty to use backend/campus.sqlite3.
# On Vercel, use a pooled PostgreSQL connection string with sslmode=require.
DATABASE_URL=
APP_ENV=development
DEMO_SEED=true
# Optional locally. Set a separate password (12+ characters) on Vercel.
DEMO_PASSWORD=
# Optional exact browser origin. Keep empty for multiple Vercel preview URLs.
PUBLIC_ORIGIN=
AI_MODE=mock
OPENROUTER_API_KEY=
# Only used with AI_MODE=openrouter, e.g. a supported deepseek/... model ID.
OPENROUTER_MODEL=
