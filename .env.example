# Locally, leave DATABASE_URL empty to use backend/campus.sqlite3.
# On Vercel, use a pooled PostgreSQL connection string with sslmode=require.
DATABASE_URL=
APP_ENV=development
DEMO_SEED=true
# Optional locally. Set a separate password (12+ characters) on Vercel.
DEMO_PASSWORD=
# Optional account-specific passwords (12–128 characters). Applied at startup.
STUDENT1=
STUDENT2=
STUDENT3=
# Optional exact browser origin. Keep empty for multiple Vercel preview URLs.
PUBLIC_ORIGIN=
AI_MODE=mock
# Only used with AI_MODE=polza. Store the key in .env or a deployment secret.
LLM_API_KEY=
LLM_BASE_URL=https://polza.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
# Only used with AI_MODE=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
